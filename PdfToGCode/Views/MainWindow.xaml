<Window x:Class="PdfToGCode.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:PdfToGCode.Rendering"
        Title="PDF to G-Code" Height="768" Width="1024" WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ToolBar Grid.Row="0" Height="40">
            <Button Name="BtnImport" Content="Import PDF" Click="BtnImport_Click" Margin="5"/>
            <Separator/>
            <Button Name="BtnFont" Content="Single-line Font" Click="BtnFont_Click" Margin="5" IsEnabled="False"/>
            <Button Name="BtnGenerate" Content="Generate G-code" Click="BtnGenerate_Click" Margin="5" IsEnabled="False"/>
            <Separator/>
            <Button Name="BtnSave" Content="Save G-code" Click="BtnSave_Click" Margin="5" IsEnabled="False"/>
        </ToolBar>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: PDF Preview -->
            <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="1" Margin="5">
                <!-- WebBrowser needs to be hosted carefully. -->
                <WebBrowser Name="PdfBrowser"/>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="LightGray"/>

            <!-- Right Panel: Vector Preview -->
            <Border Grid.Column="2" BorderBrush="Gray" BorderThickness="1" Margin="5" ClipToBounds="True">
                <rendering:ZoomPanCanvas x:Name="VectorCanvas"/>
            </Border>
        </Grid>
    </Grid>
</Window>
