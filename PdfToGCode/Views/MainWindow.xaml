<Window x:Class="PdfToGCode.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:PdfToGCode.Rendering"
        Title="PDF to G-Code" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Progress -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="20,15" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Title -->
                    <ColumnDefinition Width="*"/>    <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/> <!-- Actions -->
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock Text="PDF to G-Code" Style="{StaticResource HeaderTextStyle}" Margin="0"/>
                    <TextBlock Text="Convert documents to CNC paths" Style="{StaticResource LabelTextStyle}" FontSize="12"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Name="BtnImport" Content="Import PDF" Click="BtnImport_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,10,0"/>
                    <Button Name="BtnSelectFont" Content="Load Font" Click="BtnSelectFont_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,10,0"/>
                    <Button Name="BtnFont" Content="Convert Text" Click="BtnFont_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,10,0" IsEnabled="False"/>
                    <Button Name="BtnGenerate" Content="Generate G-Code" Click="BtnGenerate_Click" Style="{StaticResource ModernButtonStyle}" Margin="0,0,10,0" IsEnabled="False"/>
                    <Button Name="BtnSave" Content="Save File" Click="BtnSave_Click" Style="{StaticResource ModernButtonStyle}" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading Indicator -->
        <ProgressBar Name="LoadingBar" Grid.Row="1" Height="4" IsIndeterminate="True" Visibility="Collapsed"
                     Background="Transparent" BorderThickness="0" Foreground="{StaticResource PrimaryBrush}"/>

        <!-- Content Area -->
        <Grid Grid.Row="2" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/> <!-- Spacer for Splitter -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: PDF Preview -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Original PDF Layout" Style="{StaticResource LabelTextStyle}"/>
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                    <WebBrowser Name="PdfBrowser"/>
                </Border>
            </Grid>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="5" Background="Transparent" ShowsPreview="True"/>

            <!-- Right Panel: Vector Preview -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Single-Line Vector Preview" Style="{StaticResource LabelTextStyle}"/>
                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" ClipToBounds="True">
                    <rendering:ZoomPanCanvas x:Name="VectorCanvas"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
